# ==============================================================================
# TANDUR - UNIFIED PRODUCTION ENVIRONMENT REFERENCE (.env)
# ==============================================================================
# File ini merangkum seluruh variabel lingkungan produksi untuk platform TANDUR.
# Pada VPS Native (Systemd/PM2):
#   - Salin variabel backend ke /var/www/tandur/backend/.env
#   - Salin variabel frontend ke /var/www/tandur/frontend/.env.local
# Pada Deployment Docker Compose:
#   - Salin file ini menjadi .env di root proyek (/var/www/tandur/.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL 16 + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_USER=tandur_admin
POSTGRES_PASSWORD=GantiDenganPasswordDatabaseYangSangatKuat369!
POSTGRES_DB=tandur_db
POSTGRES_PORT=5432
# Untuk deployment native (localhost):
DATABASE_URL=postgresql+asyncpg://tandur_admin:GantiDenganPasswordDatabaseYangSangatKuat369!@127.0.0.1:5432/tandur_db
# Untuk deployment docker compose (internal service name: db):
# DATABASE_URL=postgresql+asyncpg://tandur_admin:GantiDenganPasswordDatabaseYangSangatKuat369!@db:5432/tandur_db

# ------------------------------------------------------------------------------
# 2. BACKEND FASTAPI & SECURITY
# ------------------------------------------------------------------------------
PROJECT_NAME="TANDUR - Platform Pertanian Presisi & Digital Agronomy"
VERSION=0.1.0
API_V1_PREFIX=/api
ENVIRONMENT=production
DEBUG=False

# Buat kunci acak dengan: openssl rand -hex 32
SECRET_KEY=ganti_dengan_64_karakter_hex_acak_dari_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Domain CORS yang diizinkan (format JSON string array)
BACKEND_CORS_ORIGINS=["https://tandur.yourdomain.com"]

# ------------------------------------------------------------------------------
# 3. GOOGLE EARTH ENGINE (GEE)
# ------------------------------------------------------------------------------
# Letakkan file service account JSON (paci-x-a7a003954fc1.json) pada direktori yang aman:
# Native: /var/www/tandur/backend/credentials/paci-x-a7a003954fc1.json
# Docker: /app/credentials/paci-x-a7a003954fc1.json
GEE_KEY_PATH=/var/www/tandur/backend/credentials/paci-x-a7a003954fc1.json
GEE_SERVICE_ACCOUNT=astral-monitor@paci-x.iam.gserviceaccount.com
GEE_PROJECT=paci-x

# ------------------------------------------------------------------------------
# 4. MAPBOX TOKENS (Rendering Peta & Spasial)
# ------------------------------------------------------------------------------
MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXIiLCJhIjoiY2xleGFtcGxlIn0.example_replace_with_real_token
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXIiLCJhIjoiY2xleGFtcGxlIn0.example_replace_with_real_token

# ------------------------------------------------------------------------------
# 5. FRONTEND NEXT.JS SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
NEXT_PUBLIC_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# 6. EMAIL / SMTP ALERTING & NOTIFIKASI
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifikasi@yourdomain.com
SMTP_PASSWORD=ganti_dengan_app_password_email
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_TLS=True
FRONTEND_URL=https://tandur.yourdomain.com
