[Unit]
Description=TANDUR Next.js 14 Frontend Application
After=network.target tandur-backend.service
Wants=tandur-backend.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/tandur/frontend

# Environment settings
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment="PATH=/usr/bin:/usr/local/bin:/bin"

# Eksekusi Next.js standalone runner atau standard next start
ExecStart=/usr/bin/npm run start -- -p 3000 -H 127.0.0.1

Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30

# Sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/www/tandur/frontend

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
