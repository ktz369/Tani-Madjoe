# ==============================================================================
# TANDUR - FRONTEND NEXT.JS PRODUCTION ENVIRONMENT CONFIGURATION
# Lokasi file di server: /var/www/tandur/frontend/.env.local (atau .env.production)
# ==============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Token Mapbox publik untuk rendering peta polygon, satelit basemap, dan analisis petak
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXIiLCJhIjoiY2xleGFtcGxlIn0.example_replace_with_real_token

# (Opsional) URL Endpoint Backend API
# Jika Nginx dikonfigurasi me-reverse-proxy /api ke backend port 8000 pada domain yang sama,
# Anda dapat mengosongkannya atau mengisinya dengan /api (default relative).
# Jika menggunakan subdomain terpisah (contoh: api.yourdomain.com), isi dengan URL penuh:
NEXT_PUBLIC_API_BASE_URL=/api
