# ==============================================================================
# TANDUR - BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# Lokasi file di server: /var/www/tandur/backend/.env
# Hak akses file: chmod 600 .env (Hanya pemilik yang dapat membaca/menulis)
# ==============================================================================

# --- Pengaturan Aplikasi FastAPI ---
PROJECT_NAME="TANDUR - Platform Pertanian Presisi & Digital Agronomy"
VERSION=0.1.0
API_V1_PREFIX=/api
ENVIRONMENT=production
DEBUG=False

# --- Database PostgreSQL + PostGIS ---
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# Catatan: Gunakan password yang kuat dan acak di server produksi!
POSTGRES_USER=tandur_admin
POSTGRES_PASSWORD=GantiDenganPasswordDatabaseYangSangatKuat369!
POSTGRES_DB=tandur_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tandur_admin:GantiDenganPasswordDatabaseYangSangatKuat369!@127.0.0.1:5432/tandur_db

# --- Keamanan & JWT Token ---
# Generate secret key dengan: openssl rand -hex 32
SECRET_KEY=ganti_dengan_64_karakter_hex_acak_dari_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Google Earth Engine (GEE) Satellite Integration ---
# Path absolut ke Service Account JSON file di server VPS
GEE_KEY_PATH=/var/www/tandur/backend/credentials/paci-x-a7a003954fc1.json
GEE_SERVICE_ACCOUNT=astral-monitor@paci-x.iam.gserviceaccount.com
GEE_PROJECT=paci-x

# --- Mapbox Basemap & Spatial Rendering ---
MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXIiLCJhIjoiY2xleGFtcGxlIn0.example_replace_with_real_token

# --- CORS (Cross-Origin Resource Sharing) ---
# Tentukan domain produksi yang diizinkan mengakses API (format JSON array)
BACKEND_CORS_ORIGINS=["https://tandur.yourdomain.com", "https://api.yourdomain.com"]

# --- Email / SMTP Settings (Notifikasi & Alerting Cuaca/Penyakit) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifikasi@yourdomain.com
SMTP_PASSWORD=ganti_dengan_app_password_email
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_TLS=True

# --- Frontend URL (Untuk link aktivasi/laporan di email) ---
FRONTEND_URL=https://tandur.yourdomain.com
